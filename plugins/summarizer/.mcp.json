{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest"
      ]
    },
    "video-to-text-mcp": {
      "command": "npx",
      "args": [
        "video-to-text-mcp"
      ],
      "env": {
        "WHISPER_MODEL": "large"  
      }
    },
    "flomo-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "@chatmcp/flomo-mcp"
      ],
      "env": {
        "FLOMO_API_URL": "${FLOMO_API_URL}"
      }
    }
  }
}
